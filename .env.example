# Copy to .env and fill in from your Schwab developer app.
# .env is git-ignored — never commit real credentials.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# Must EXACTLY match the callback URL registered on your Schwab app
# (include the port if your app registered one, e.g. https://127.0.0.1:8182):
SCHWAB_CALLBACK_URL=https://127.0.0.1
# Where the OAuth token DB is stored (git-ignored).
# Leave unset to use the repo-root default (recommended — CWD-independent):
# SCHWAB_TOKENS_DB=./secrets/tokens.db

# Finnhub — analyst/estimates research (slow loop only). Free key, no expiry:
#   https://finnhub.io/register  -> copy the key from the dashboard.
FINNHUB_API_KEY=

# Alpaca — live market news (slow loop only). Free key pair, no expiry.
#   https://app.alpaca.markets/  -> Home -> API Keys -> Generate.
# Data-only here (news); we do NOT trade or quote through Alpaca (IEX-only price).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# FRED — supplementary macro/regime indicators (VIX, yield curve, HY spread).
# Free key, no expiry:  https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# DASHBOARD — password-gates the monitor page (dashboard/app.py). Fails CLOSED:
# with no DASH_PASS the page serves nothing. Pick a strong password.
DASH_USER=admin
DASH_PASS=

# NEWSLETTER — weekly investor letter. Unset -> still generated, not emailed.
# ⚠️ DigitalOcean droplets block ALL outbound SMTP ports (25/465/587/2525) —
# Gmail app passwords CANNOT work there. Use Resend (HTTPS, free 100/day):
#   https://resend.com -> sign up with the address you want mail delivered to
#   -> API Keys -> create. Without a verified domain, Resend only delivers to
#   the account owner's own address, from onboarding@resend.dev — fine here.
NEWSLETTER_TO=
NEWSLETTER_FROM=onboarding@resend.dev
RESEND_API_KEY=
# Non-DO boxes may use Gmail SMTP instead of RESEND_API_KEY:
NEWSLETTER_APP_PASSWORD=

# NTFY — phone push alerts when the monitor fires a stop / take-profit.
# Pick a long random topic (it's the only auth — treat it like a password),
# subscribe to it in the ntfy app (https://ntfy.sh). Unset -> alerts off.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh   # override for a self-hosted ntfy
