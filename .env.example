# Copy to .env and fill in from your Schwab developer app.
# .env is git-ignored — never commit real credentials.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# Must EXACTLY match the callback URL registered on your Schwab app
# (include the port if your app registered one, e.g. https://127.0.0.1:8182):
SCHWAB_CALLBACK_URL=https://127.0.0.1
# Where the OAuth token DB is stored (git-ignored).
# Leave unset to use the repo-root default (recommended — CWD-independent):
# SCHWAB_TOKENS_DB=./secrets/tokens.db

# Finnhub — analyst/estimates research (slow loop only). Free key, no expiry:
#   https://finnhub.io/register  -> copy the key from the dashboard.
FINNHUB_API_KEY=
