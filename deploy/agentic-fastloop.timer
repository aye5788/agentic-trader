[Unit]
Description=agentic-trader fast loop schedule (10:00 ET, weekdays)
Documentation=file:/opt/agentic-trader/docs/OPSLOG.md

[Timer]
# Local time. The box is America/New_York (`timedatectl`), and systemd 249 has
# no per-timer timezone field — OnCalendar timezones landed in 252 — so this
# depends on the box TZ exactly as the cron lines it replaces did.
# ⛔ If the droplet's timezone is ever changed, EVERY trading time moves with it.
OnCalendar=Mon-Fri 10:00:00

# ⛔ Persistent=false IS LOAD-BEARING. With Persistent=true a missed run fires
# on the next boot — so a droplet that was down at 10:00 and came up at 14:00
# would execute the morning's target book four hours late, against a tape that
# has moved. A trading job missed is a trading job SKIPPED, never deferred.
Persistent=false

# Default accuracy is 1 minute of slop, which cron did not have. The 10:35
# session start is spaced off this job's finish time, so keep the start exact.
AccuracySec=1s
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
