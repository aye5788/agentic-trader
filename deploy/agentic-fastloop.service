[Unit]
Description=agentic-trader fast loop (execution of the stored target book)
Documentation=file:/opt/agentic-trader/docs/OPSLOG.md

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/agentic-trader
ExecStart=/opt/agentic-trader/deploy/run_fast_loop.sh

# `claude` is at /usr/bin, but /root/.local/bin is included for the same reason
# agentic-review.service needs it: a service PATH is not a login PATH, and that
# gap silently killed every scheduled review for a day (OPSLOG 2026-08-13).
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/root/.local/bin
Environment=HOME=/root

# --- THIS JOB HAD NO BOUNDS OF ANY KIND UNTIL 2026-08-13 --------------------
# It is a headless `claude -p` run that PLACES REAL ORDERS, and it had no memory
# limit and — more dangerous — no timeout. A wedged `claude -p` would sit here
# indefinitely holding ~500MB, and the only thing stopping it colliding with the
# 10:35 session was the ASSUMPTION that a 10:00 job finishes by 10:04.
#
# The bound below is the fix: 10:00 + 20min ends it by 10:20, so it cannot still
# be running when the 10:35 session starts. Observed runtime is ~4 min
# (logs/fast.log), so 20 min is ~5x headroom — generous on purpose. The failure
# this repo repeats is a tight guessed limit that kills a good run.
# ⛔ TimeoutStartSec IS THE BOUND — NOT RuntimeMaxSec.
# For Type=oneshot, systemd IGNORES RuntimeMaxSec ("RuntimeMaxSec= has no effect
# in combination with Type=oneshot", `systemd-analyze verify`). It was set here
# on 2026-08-14 and did nothing; caught before it ever ran. Worse, `systemctl
# show` happily REPORTS RuntimeMaxUSec, so the inert setting looked enforced.
# A directive that reads as a guard and enforces nothing is this repo's
# recurring defect — so it is deleted rather than left beside the real one.
TimeoutStartSec=1200

# Memory: a catastrophe backstop, NOT a tuned budget. Nothing has ever measured
# this job's peak (no telemetry exists), so MemoryHigh throttles first and
# MemoryMax sits well above anything plausible for a single model run. Tighten
# from a recorded peak, never from a guess — a guessed 700M cap OOM-killed every
# review this system ever ran.
MemoryAccounting=yes
MemoryHigh=900M
MemoryMax=1400M
MemorySwapMax=300M
CPUAccounting=yes

# systemd refuses to start a unit that is already running, so two fast loops
# cannot overlap. That is a property of the unit, not lock code we maintain.
